{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndreBaltazar8/spec-pax/manifest.schema.json",
  "title": "PAX version 0 manifest",
  "type": "object",
  "required": ["version", "features", "levels", "primitives", "textures"],
  "properties": {
    "version": {"const": 0},
    "features": {"type":"array","uniqueItems":true,"items":{"enum":["primitive-modes","final-order","extension-packets"]}},
    "levels": {"type":"integer","minimum":1,"maximum":65536},
    "bootstrapExtensionPackets": {"type":"integer","minimum":0},
    "primitives": {"type":"array","items":{"$ref":"#/$defs/primitive"}},
    "textures": {"type":"array","items":{"$ref":"#/$defs/texture"}}
  },
  "$defs": {
    "uint": {"type":"integer","minimum":0,"maximum":4294967295},
    "attribute": {
      "type":"object","required":["semantic","componentType","itemSize","normalized"],
      "properties":{"semantic":{"type":"string"},"componentType":{"enum":[5120,5121,5122,5123,5125,5126]},"itemSize":{"type":"integer","minimum":1,"maximum":16},"normalized":{"type":"boolean"},"morph":{"$ref":"#/$defs/uint"}}
    },
    "primitive": {
      "type":"object","required":["mesh","primitive","indexWidth","baseVertices","finalVertices","baseTriangles","finalTriangles","levels","attributes"],
      "properties":{"mesh":{"$ref":"#/$defs/uint"},"primitive":{"$ref":"#/$defs/uint"},"indexWidth":{"enum":[1,2,3]},"originalMode":{"enum":[0,1,2,3,4,5,6]},"baseVertices":{"$ref":"#/$defs/uint"},"finalVertices":{"$ref":"#/$defs/uint"},"baseTriangles":{"$ref":"#/$defs/uint"},"finalTriangles":{"$ref":"#/$defs/uint"},"levels":{"type":"integer","minimum":1,"maximum":65536},"attributes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/attribute"}}}
    },
    "texture": {
      "type":"object","required":["image","width","height","baseWidth","baseHeight","levels","codec"],
      "properties":{"image":{"$ref":"#/$defs/uint"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"baseWidth":{"type":"integer","minimum":1},"baseHeight":{"type":"integer","minimum":1},"levels":{"type":"integer","minimum":1},"codec":{"enum":["lattice","tile-lattice","source","ktx2","ktx2-mip"]},"tileCount":{"type":"integer","minimum":1},"tileSize":{"type":"integer","minimum":1}},
      "allOf":[{"if":{"properties":{"codec":{"const":"tile-lattice"}}},"then":{"required":["tileCount","tileSize"]}}]
    }
  }
}
